# ============================================================
# ENVIRONMENT VARIABLES — copy this file to .env and fill in
# ============================================================

# ── Notion Publishing (optional) ──────────────────────────
# Get your page ID from any Notion page URL:
# https://www.notion.so/Your-Page-Title-<PAGE_ID>
# The ID is the 32-character hex string at the end.
NOTION_PAGE_ID=

# Optional: Notion integration token (if MCP connector is not set up)
# Create one at https://www.notion.so/my-integrations
NOTION_API_KEY=

# ── NewsAPI (optional) ────────────────────────────────────
# Free tier at https://newsapi.org/ — 100 requests/day
# Enables additional news sources beyond RSS feeds.
# Set enabled: true in config/sources.yaml after adding this key.
NEWSAPI_KEY=
